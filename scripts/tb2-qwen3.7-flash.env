# Terminal-Bench 2.0 配置：openrouter/qwen/qwen3.7-flash（1M 上下文，单次最多输出 65536）
#   set -a; . scripts/tb2-qwen3.7-flash.env; set +a; scripts/run_tb2.sh
MODEL=openrouter/qwen/qwen3.7-flash
N=10
K=1
C=2
BASELINE=none
# max_turns      300：TB2 每个任务自带 agent 超时，轮数上限不该先于时间用完（100 轮时 crack-7z-hash 先撞上限）
# max_context    200000：压在 OpenRouter 256k 的计价档位以下；原来 100k 时第 ~30 轮就开始摘要
# max_tokens     32768：配合下面的思考上限，至少留 16k 给正文和工具调用
# extra_body     reasoning.max_tokens=16000：不设时整条输出都被思考吃满（finish_reason=length，正文为空）
# price          美元 / 百万 tokens，取提示 ≥32k 那一档（TB2 的大多数调用都在这一档）
AK='max_turns=300 max_context=200000 max_tokens=32768 reasoning_replay=turn extra_body={"reasoning":{"max_tokens":16000}} price={"input":0.1,"cached":0.02,"output":0.4}'
